# Template environment untuk container Lomba (committed).
# Isi APP_KEY disediakan melalui environment deployment, bukan file ini. Ubah bila
# stack ini dirilis ke network publik.
APP_NAME="Lomba Cerdas Cermat"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://127.0.0.1:8082

# SQLite (wajib) — path di dalam container. File menyatu dengan named
# volume lomba-db sehingga persisten saat container di-recreate.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/lomba/database/database.sqlite

# Session/cache berbasis file (storage/ berada di named volume lomba-storage).
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync